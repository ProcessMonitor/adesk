<Project Sdk="Microsoft.NET.Sdk">

  <!--
    macOS adapter. Deliberately a plain net10.0 target with hand-written P/Invoke into the
    ApplicationServices / CoreGraphics / AppKit frameworks: no Xamarin.Mac workload, no
    .NET-macOS TFM, no extra SDK to install. That keeps "clone and build" working on a machine
    that only has the normal .NET SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AdeskPro.Mac</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.2.0</Version>
    <!-- P/Invoke into system frameworks; safe on any OS at build time. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdeskPro.Core\AdeskPro.Core.csproj" />
  </ItemGroup>

</Project>
